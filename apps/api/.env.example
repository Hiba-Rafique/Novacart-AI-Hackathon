# Never store an actual key in this file.
GEMINI_API_KEY=replace-with-your-api-key

# Verify availability and free-tier quota in YOUR Gemini API project.
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Host-relative paths for local `uv run`; the Dockerfile sets container paths.
DATA_DIR=./data
INDEX_DIR=./data/index
POLICIES_DIR=../../policies
RAG_TOP_K=10
MODEL_TIMEOUT_SECONDS=20
MAX_MODEL_CONCURRENCY=3
LOG_LEVEL=INFO
APP_ENV=development
APP_TIMEZONE=Asia/Karachi

# Local Docker default. Render injects PORT=10000 at runtime.
PORT=7860
